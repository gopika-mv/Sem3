
package com.example.eventregistration;
import android.content.Intent;
import android.content.SharedPreferences;
import android.os.Bundle;
import android.util.Patterns;
import android.widget.Button;
import android.widget.CheckBox;
import android.widget.EditText;
import android.widget.RadioButton;
import android.widget.Toast;

import androidx.appcompat.app.AppCompatActivity;

import java.util.ArrayList;

public class MainActivity extends AppCompatActivity {

    EditText nameEditText;
    EditText emailEditText;
    EditText addressEditText;

    RadioButton studentRadio;
    RadioButton professionalRadio;

    CheckBox androidCheckBox;
    CheckBox aiMlCheckBox;
    CheckBox cyberSecurityCheckBox;

    Button submitButton;

    // SharedPreferences constants
    public static final String PREF_NAME = "EventRegistration";

    public static final String KEY_NAME = "name";
    public static final String KEY_EMAIL = "email";
    public static final String KEY_ADDRESS = "address";
    public static final String KEY_CATEGORY = "category";
    public static final String KEY_WORKSHOPS = "workshops";

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        setContentView(R.layout.activity_main);

        // Find views
        nameEditText = findViewById(R.id.nameEditText);
        emailEditText = findViewById(R.id.emailEditText);
        addressEditText = findViewById(R.id.addressEditText);

        studentRadio = findViewById(R.id.studentRadio);
        professionalRadio = findViewById(R.id.professionalRadio);

        androidCheckBox = findViewById(R.id.androidCheckBox);
        aiMlCheckBox = findViewById(R.id.aiMlCheckBox);
        cyberSecurityCheckBox = findViewById(R.id.cyberSecurityCheckBox);

        submitButton = findViewById(R.id.submitButton);

        // Load previously saved information
        loadSavedData();

        // Submit button
        submitButton.setOnClickListener(v -> saveRegistration());
    }

    private void saveRegistration() {

        // Get values
        String name = nameEditText.getText().toString().trim();
        String email = emailEditText.getText().toString().trim();
        String address = addressEditText.getText().toString().trim();

        // Validate name
        if (name.isEmpty()) {
            nameEditText.setError("Please enter your name");
            nameEditText.requestFocus();
            return;
        }

        // Validate email
        if (email.isEmpty()) {
            emailEditText.setError("Please enter your email");
            emailEditText.requestFocus();
            return;
        }

        // Validate email format
        if (!Patterns.EMAIL_ADDRESS.matcher(email).matches()) {
            emailEditText.setError("Enter a valid email");
            emailEditText.requestFocus();
            return;
        }

        // Validate address
        if (address.isEmpty()) {
            addressEditText.setError("Please enter your address");
            addressEditText.requestFocus();
            return;
        }

        // Get registration category
        String category = "";

        if (studentRadio.isChecked()) {
            category = "Student";
        } else if (professionalRadio.isChecked()) {
            category = "Professional";
        }

        // Check category
        if (category.isEmpty()) {
            Toast.makeText(
                    this,
                    "Please select a registration category",
                    Toast.LENGTH_SHORT
            ).show();

            return;
        }

        // Get workshops
        ArrayList<String> workshops = new ArrayList<>();

        if (androidCheckBox.isChecked()) {
            workshops.add("Android Development");
        }

        if (aiMlCheckBox.isChecked()) {
            workshops.add("AI & ML");
        }

        if (cyberSecurityCheckBox.isChecked()) {
            workshops.add("Cyber Security");
        }

        // Check workshop selection
        if (workshops.isEmpty()) {
            Toast.makeText(
                    this,
                    "Please select at least one workshop",
                    Toast.LENGTH_SHORT
            ).show();

            return;
        }

        // Convert workshops to String
        String workshopString = String.join(", ", workshops);

        // Get SharedPreferences
        SharedPreferences preferences =
                getSharedPreferences(PREF_NAME, MODE_PRIVATE);

        // Save data
        SharedPreferences.Editor editor = preferences.edit();

        editor.putString(KEY_NAME, name);
        editor.putString(KEY_EMAIL, email);
        editor.putString(KEY_ADDRESS, address);
        editor.putString(KEY_CATEGORY, category);
        editor.putString(KEY_WORKSHOPS, workshopString);

        editor.apply();

        // Move to SummaryActivity
        Intent intent =
                new Intent(MainActivity.this, SummaryActivity.class);

        startActivity(intent);
    }

    private void loadSavedData() {

        SharedPreferences preferences =
                getSharedPreferences(PREF_NAME, MODE_PRIVATE);

        // Load name
        nameEditText.setText(
                preferences.getString(KEY_NAME, "")
        );

        // Load email
        emailEditText.setText(
                preferences.getString(KEY_EMAIL, "")
        );

        // Load address
        addressEditText.setText(
                preferences.getString(KEY_ADDRESS, "")
        );

        // Load category
        String category =
                preferences.getString(KEY_CATEGORY, "");

        if (category.equals("Student")) {

            studentRadio.setChecked(true);

        } else if (category.equals("Professional")) {

            professionalRadio.setChecked(true);
        }

        // Load workshops
        String workshops =
                preferences.getString(KEY_WORKSHOPS, "");

        if (workshops.contains("Android Development")) {
            androidCheckBox.setChecked(true);
        }

        if (workshops.contains("AI & ML")) {
            aiMlCheckBox.setChecked(true);
        }

        if (workshops.contains("Cyber Security")) {
            cyberSecurityCheckBox.setChecked(true);
        }
    }
}
