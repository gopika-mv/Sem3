package com.example.a5thprogram;

import android.content.Intent;
import android.net.Uri;
import android.os.Bundle;
import android.view.View;
import android.widget.Button;

import androidx.activity.EdgeToEdge;
import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity implements View.OnClickListener {

    Button map, email;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        EdgeToEdge.enable(this);
        setContentView(R.layout.activity_main);

        map = findViewById(R.id.map);
        email = findViewById(R.id.email);

        map.setOnClickListener(this);
        email.setOnClickListener(this);
    }

    @Override
    public void onClick(View v) {

        Intent intent, chooser;

        if (v.getId() == R.id.map) {

            intent = new Intent(Intent.ACTION_VIEW);
            intent.setData(Uri.parse("geo:10.065206,76.629128?q=10.065206,76.629128"));

            chooser = Intent.createChooser(intent, "Open Map");
            startActivity(chooser);

        } else if (v.getId() == R.id.email) {

            intent = new Intent(Intent.ACTION_SENDTO);
            intent.setData(Uri.parse("mailto:"));

            intent.putExtra(Intent.EXTRA_EMAIL, new String[]{"example@gmail.com"});
            intent.putExtra(Intent.EXTRA_SUBJECT, "Hello");
            intent.putExtra(Intent.EXTRA_TEXT, "This is a test email.");

            chooser = Intent.createChooser(intent, "Send Email");
            startActivity(chooser);
        }
    }
}
